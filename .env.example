# คัดลอกเป็น .env สำหรับรันในเครื่อง / บน Railway ให้ตั้งค่าใน Variables แทน
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=backend_db

# สร้างค่าใหม่ด้วย: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=180

# โดเมนหน้าบ้านที่อนุญาต (คั่นด้วย ,) — โดเมน *.up.railway.app อนุญาตอัตโนมัติ
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# FTP สำหรับอัปโหลดรูปโปรไฟล์ (FTP_HOST ใส่แค่ host ไม่ต้องมี ftp://)
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_UPLOAD_BASE_DIR=/people
FTP_PUBLIC_BASE_URL=
